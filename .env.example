# PeopleCore Server Config — copy to .env and fill in your values

# Core
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=your_super_secret_key_min_32_characters_here
JWT_EXPIRY=8h
NODE_ENV=development

# Frontend (Vite)
VITE_API_BASE=http://localhost:3001/api

# Email (Resend — https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=PeopleCore <onboarding@resend.dev>

# AI — priority: OpenAI > Ollama > local fallback
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
OLLAMA_BASE=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Stripe Billing (https://stripe.com)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# Razorpay Billing (https://razorpay.com)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_ENTERPRISE=

# SaaS
TRIAL_DAYS=14
SUPER_ADMIN_EMAILS=your@email.com

# Production database (optional — SQLite used by default for dev)
# DATABASE_URL=postgresql://peoplecore:peoplecore@localhost:5432/peoplecore
